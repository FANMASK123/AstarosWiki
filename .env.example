# AstarosWiki 环境变量模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库

# ── 数据库 ──────────────────────────────
DB_USERNAME=astaros_wiki
DB_PASSWORD=your_secure_password_here

# ── Redis ───────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ── JWT ─────────────────────────────────
# 生成方式：openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_change_me

# ── 服务器 ──────────────────────────────
SERVER_PORT=8801

# ── Knife4j（生产环境设为 false）────────
KNIFE4J_ENABLE=true
