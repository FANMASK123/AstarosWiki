# ============================================================
# AstarosWiki .gitignore
# ============================================================

# —— 依赖 ————————————————————————————————
node_modules/
.pnpm-store/

# —— 构建产物 ——————————————————————————————
target/
dist/
build/
*.class
*.jar
*.war
*.ear

# —— 前端 ——————————————————————————————————
.vite/
*.local

# —— IDE ————————————————————————————————————
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# —— OS —————————————————————————————————————
.DS_Store
Thumbs.db
Desktop.ini

# —— 环境 & 密钥 ————————————————————————————
.env
.env.local
.env.*.local
*.pem
*.key

# —— 日志 & 临时 ————————————————————————————
*.log
*.tmp
*.temp
.turbo/
coverage/

# —— Python（如有脚本）———————————————————————
__pycache__/
*.py[cod]
.venv/
venv/
